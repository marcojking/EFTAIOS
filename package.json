{
  "name": "eftaios-digital",
  "version": "1.0.0",
  "description": "Digital LAN version of Escape from the Aliens in Outer Space",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "canvas": "^3.2.0",
    "concurrently": "^8.2.2",
    "pdf-poppler": "^0.2.3",
    "pdf2pic": "^3.2.0",
    "pdfjs-dist": "^5.4.530",
    "sharp": "^0.34.5"
  }
}
